# ---------------------------------------------------------------------------
# MMG app — environment
#
# Every value here is optional. With none of them set, the app builds and runs,
# and forms post to FormSubmit.co addressed to contact@millersmarketinggroup.com.
# ---------------------------------------------------------------------------

# FormSubmit endpoint for RSVPs, sponsorship inquiries, and contact messages.
#
# Recommended for production: create a FormSubmit alias so the inbox address
# isn't sitting in the client bundle for scrapers to find.
#   1. Send one submission to https://formsubmit.co/ajax/contact@millersmarketinggroup.com
#   2. Andrew confirms via the activation email FormSubmit sends him (one time only)
#   3. FormSubmit replies with a random alias token — paste the URL below
#
# NEXT_PUBLIC_FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/your-alias-token

# Set to "true" to run the app as a pure UI demo with no outbound email.
# Confirmation screens still appear; nothing is delivered. Useful for a
# stakeholder preview deployment that shouldn't fill Andrew's inbox.
# NEXT_PUBLIC_FORMS_DISABLED=false
