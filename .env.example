# MMG App — environment
#
# Nothing here is needed to run the app locally: pages render, RSVPs are stored
# in the browser, and form submissions simply report that they couldn't be sent.
# These matter in a deployed environment.

# ---------------------------------------------------------------------------
# Link previews
# ---------------------------------------------------------------------------
# The absolute host used for og:image and the Twitter card. Leave unset on
# Vercel: the app falls back to VERCEL_PROJECT_PRODUCTION_URL, which already
# tracks the project's production domain. Set it only to override that — e.g.
# once a custom domain fronts the app from somewhere Vercel doesn't know about.
#
# Getting this wrong is silent: the card still renders, but its image 404s and
# every share comes up blank.
# NEXT_PUBLIC_SITE_URL=https://mmg-app-pwa.vercel.app

# ---------------------------------------------------------------------------
# Forms (RSVPs, sponsorship inquiries, contact messages)
# ---------------------------------------------------------------------------
# Required to actually deliver mail. Create a sending-scoped key in the Resend
# dashboard (Settings -> API keys) and set it in the Vercel project. Never
# commit the real value.
#
# Without it, /api/contact logs an error and returns a failure — the visitor
# still sees their confirmation, but nothing reaches the inbox.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where submissions land. Defaults to contact@millersmarketinggroup.com.
# MMG_MAIL_TO=contact@millersmarketinggroup.com

# Sender. Must be on a domain verified in Resend — millersmarketinggroup.com
# already is. Defaults to "MMG App <noreply@millersmarketinggroup.com>".
# MMG_MAIL_FROM=MMG App <noreply@millersmarketinggroup.com>

# Set on a preview deployment that shouldn't reach the real inbox. The UI then
# reports "demo mode" rather than a delivery failure.
# MMG_FORMS_DISABLED=true
